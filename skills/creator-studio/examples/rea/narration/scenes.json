[
 {
  "id": "01",
  "title": "01 开场",
  "start": 0.8,
  "end": 21.776,
  "dur": 20.976,
  "cues": [
   {
    "t": 0.8,
    "e": 3.248,
    "text": "大家好，我是知识猫。"
   },
   {
    "t": 3.248,
    "e": 12.104,
    "text": "你有没有过这种时候：在别人的软件里看到一个特别好用的功能，很想知道它是怎么做出来的，可手里根本没有源代码。"
   },
   {
    "t": 12.104,
    "e": 15.752,
    "text": "今天聊的这个开源项目，就是专门干这件事的。"
   },
   {
    "t": 15.752,
    "e": 20.576,
    "text": "它叫 REA，全称 Reverse Engineer Anything，逆向一切。"
   }
  ]
 },
 {
  "id": "02",
  "title": "02 热度",
  "start": 21.776,
  "end": 37.544,
  "dur": 15.768,
  "cues": [
   {
    "t": 21.776,
    "e": 24.032,
    "text": "它今年四月才开源。"
   },
   {
    "t": 24.032,
    "e": 29.912,
    "text": "半年时间，拿到了十四万六千多颗星，三万三千多次复刻。"
   },
   {
    "t": 29.912,
    "e": 36.344,
    "text": "十月十一号刚发布六点四版本，几乎每天都有新提交，开源协议是 MIT。"
   }
  ]
 },
 {
  "id": "03",
  "title": "03 它是什么",
  "start": 37.544,
  "end": 74.888,
  "dur": 37.344,
  "cues": [
   {
    "t": 37.544,
    "e": 45.584,
    "text": "一句话概括：REA 是一个专为 AI 智能体打造的逆向工程 MCP 服务器。"
   },
   {
    "t": 45.584,
    "e": 49.448,
    "text": "你不用自己去啃汇编，而是直接问你的智能体。"
   },
   {
    "t": 49.448,
    "e": 56.696,
    "text": "比如：帮我搞清楚某个笔记软件的搜索是怎么实现的，附上证据，再在我的项目里做一个类似的。"
   },
   {
    "t": 56.696,
    "e": 62.168,
    "text": "智能体通过 MCP 调用 REA，去检查目标、追踪相关代码。"
   },
   {
    "t": 62.168,
    "e": 70.232,
    "text": "REA 把发现连同证据一起交回来，智能体再基于这些去解释、去实现、去测试。"
   },
   {
    "t": 70.232,
    "e": 73.688,
    "text": "同一套能力，在终端里也能直接用。"
   }
  ]
 },
 {
  "id": "04",
  "title": "04 能分析什么",
  "start": 74.888,
  "end": 110.168,
  "dur": 35.28,
  "cues": [
   {
    "t": 74.888,
    "e": 77.144,
    "text": "它覆盖的范围有点夸张。"
   },
   {
    "t": 77.144,
    "e": 85.184,
    "text": "原生二进制，可以接 Hopper、Ghidra 或者 IDA，拿到伪代码、汇编、字符串和调用关系。"
   },
   {
    "t": 85.184,
    "e": 92.024,
    "text": "JavaScript 和 Electron 应用，能还原模块、导入关系和进程间通信。"
   },
   {
    "t": 92.024,
    "e": 102.704,
    "text": "还有网站、抓包文件、点 NET 程序集、安卓安装包和真机、Go、WebAssembly、以太坊字节码、固件，甚至 Flutter 应用。"
   },
   {
    "t": 102.704,
    "e": 108.968,
    "text": "而静态的 JavaScript 和点 NET 分析，连原生分析引擎都不需要装。"
   }
  ]
 },
 {
  "id": "05",
  "title": "05 实测",
  "start": 110.168,
  "end": 161.528,
  "dur": 51.36,
  "cues": [
   {
    "t": 110.168,
    "e": 113.792,
    "text": "光说不练没意思，我们直接拿我自己开刀。"
   },
   {
    "t": 113.792,
    "e": 119.648,
    "text": "我，知识猫，就是一个用 JavaScript 画出来的网页角色。"
   },
   {
    "t": 119.648,
    "e": 124.088,
    "text": "在终端里敲一行命令，让 REA 分析我的原型目录。"
   },
   {
    "t": 124.088,
    "e": 132.92,
    "text": "六秒钟，它读完了五个相关文件，解析了两个 JavaScript 模块，遍历了一万四千多个语法树节点。"
   },
   {
    "t": 132.92,
    "e": 138.176,
    "text": "它认出了我的动画引擎和绘制模块，也找到了两个页面入口。"
   },
   {
    "t": 138.176,
    "e": 143.24,
    "text": "最让我喜欢的是最后这一段：它会主动告诉你，局限在哪里。"
   },
   {
    "t": 143.24,
    "e": 153.104,
    "text": "比如代码只是被当作静态文本解析，从来没有执行过；静态的导入关系，也不能证明运行时真的会走到。"
   },
   {
    "t": 153.104,
    "e": 160.328,
    "text": "结论、证据和边界放在一起，这对智能体特别重要，它就不会把猜测当成事实。"
   }
  ]
 },
 {
  "id": "06",
  "title": "06 官方案例",
  "start": 161.528,
  "end": 198.104,
  "dur": 36.576,
  "cues": [
   {
    "t": 161.528,
    "e": 164.36,
    "text": "官方还放了几个相当硬核的案例。"
   },
   {
    "t": 164.36,
    "e": 173.984,
    "text": "老游戏 DX-Ball：REA 顺着一次声音调用，找到计算声像位置的函数，把残缺的伪代码还原成 C 代码。"
   },
   {
    "t": 173.984,
    "e": 181.616,
    "text": "还原结果通过了三千两百多个原始 x86 测试用例，六十三个编译后的字节完全一致。"
   },
   {
    "t": 181.616,
    "e": 190.064,
    "text": "还有 Notion：从页面里的剪贴板接口出发，一路追到预加载脚本、进程间通信，再到主进程。"
   },
   {
    "t": 190.064,
    "e": 196.904,
    "text": "以及一款 PC-98 平台的原版游戏，恢复了十六位 DOS 时代的子弹环计算。"
   }
  ]
 },
 {
  "id": "07",
  "title": "07 上手",
  "start": 198.104,
  "end": 219.512,
  "dur": 21.408,
  "cues": [
   {
    "t": 198.104,
    "e": 199.568,
    "text": "上手很简单。"
   },
   {
    "t": 199.568,
    "e": 205.208,
    "text": "装好 Node 二十二以上的版本，运行 npx rea-agents setup。"
   },
   {
    "t": 205.208,
    "e": 214.448,
    "text": "选择你用的智能体，Claude Code、Codex、Cursor、Gemini CLI 都支持，确认改动，再重启一下就可以了。"
   },
   {
    "t": 214.448,
    "e": 218.312,
    "text": "分析全部在本地运行，不会上传你的程序。"
   }
  ]
 },
 {
  "id": "08",
  "title": "08 提醒与结尾",
  "start": 219.512,
  "end": 240.744,
  "dur": 21.232,
  "cues": [
   {
    "t": 219.512,
    "e": 221.144,
    "text": "最后提醒两句。"
   },
   {
    "t": 221.144,
    "e": 226.376,
    "text": "逆向工具是把双刃剑，只分析你有权分析的软件。"
   },
   {
    "t": 226.376,
    "e": 235.04,
    "text": "运行时捕获会真的执行目标程序，要留意它的影响；IDA、Hopper 这类商业工具，也需要合法授权。"
   },
   {
    "t": 235.04,
    "e": 237.08,
    "text": "好了，这期就到这里。"
   },
   {
    "t": 237.08,
    "e": 239.744,
    "text": "我是知识猫，我们下期见。"
   }
  ]
 }
]